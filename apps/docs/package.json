{
  "name": "@framekit/docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run check:content && next build && pagefind --site out && node scripts/report-search-size.mjs",
    "typecheck": "tsc --noEmit",
    "test:export": "node --test test/export.test.mjs test/locale-export.test.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:stories": "node scripts/test-stories.mjs",
    "test:shell": "node scripts/test-shell.mjs",
    "check:content": "node --test test/content-links.test.mjs && node scripts/check-content-links.mjs",
    "test:locales": "node scripts/test-locales.mjs",
    "test:search": "node scripts/test-search.mjs",
    "test:e2e": "playwright test",
    "test:pages": "node scripts/smoke-pages.mjs"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.4.5",
    "github-slugger": "2.0.0",
    "mdast-util-to-string": "4.0.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "sass": "1.107.1",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@storybook/addon-themes": "10.6.5",
    "@storybook/nextjs-vite": "10.6.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/mdx": "2.0.14",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "26.1.0",
    "pagefind": "1.6.0",
    "playwright": "1.64.1",
    "storybook": "10.6.5",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
