{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@framekit/runtime": ["packages/runtime/src/index.ts"],
      "@framekit/testkit": ["packages/testkit/src/index.ts"],
      "@framekit/final-cut": ["adapters/final-cut/typescript/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "adapters/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
